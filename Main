<body>

  <script>
    // Três dados em variáveis separadas
    let nome = prompt("Qual é o seu nome?");
    let sobrenome = prompt("Qual é o seu sobrenome?");
    let anonascimento = Number(prompt("Em que ano você nasceu?"));
    
    let idade = 2026 - anonascimento

    // confirm() devolve true (OK) ou false (Cancelar)
    let alunoAtivo = confirm("É aluno ativo da instituição?");

    console.log("CRACHÁ VIRTUAL: " + sobrenome.toUpperCase() + " " + nome)

    console.log("Idade estimada: " + idade) 

    console.log("O seu primeiro " + nome.length + " letras")

    if (alunoAtivo = true){
        console.log("Estatuto de aluno: Ativo")
    }
    else {
        console.log("Estatuto de aluno: Desativado")
    }


</script>
</body>
